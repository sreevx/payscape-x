# PAYSCAPE-X frontend environment variables
# Copy to .env.local and adjust as needed.

# Base URL of the FastAPI backend (must be reachable from the browser).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Application-level Demo Mode. Set to "false" to disable the mock data layer.
NEXT_PUBLIC_DEMO_MODE=true

# Environment label shown in the top bar (development / staging / production).
NEXT_PUBLIC_APP_ENV=development