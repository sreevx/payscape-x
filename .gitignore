# ------------------------------------------------------------------
# PAYSCAPE-X root .gitignore
# ------------------------------------------------------------------

# --- Environment & secrets ----------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Dependencies ---------------------------------------------------
node_modules/

# --- Frontend build artifacts ---------------------------------------
.next/
out/
dist/
build/
*.tsbuildinfo

# --- Python ---------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Local databases -------------------------------------------------
*.db
*.sqlite3

# --- Logs ------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS / editor ------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
