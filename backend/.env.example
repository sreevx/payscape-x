# PAYSCAPE-X backend environment variables
# Copy to .env (next to this file) and adjust.

# --- Application --------------------------------------------------------
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# Demo Mode: allows serving synthetic demo data (Part 1 has no AI output).
DEMO_MODE=true

# --- Database -----------------------------------------------------------
# PostgreSQL (psycopg 3 driver). Local development defaults — change these.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://payscape:payscape@localhost:5432/payscape_x

# --- CORS ---------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# --- Decision Agent (Part 8) ---------------------------------------------
# LLM provider for the AI Decision Agent. The default "none" makes the
# agent use the mandatory deterministic fallback — the system works with
# NO API key. To enable the OpenAI-compatible HTTP provider:
#   DECISION_LLM_PROVIDER=openai_compatible
#   DECISION_LLM_BASE_URL=https://api.openai.com/v1
#   DECISION_LLM_API_KEY=<never commit real keys>
#   DECISION_LLM_MODEL=gpt-4o-mini
#   DECISION_LLM_TIMEOUT_MS=30000
DECISION_LLM_PROVIDER=none
DECISION_LLM_BASE_URL=
DECISION_LLM_API_KEY=
DECISION_LLM_MODEL=
DECISION_LLM_TIMEOUT_MS=30000

# --- Razorpay webhooks (Part 9, TEST MODE only) ---------------------------
# Webhook secret from the Razorpay Dashboard (test mode). When set, the
# webhook endpoint enforces HMAC-SHA256 signature verification and rejects
# invalid/missing X-Razorpay-Signature headers with 400. NEVER commit a
# real secret. Leave empty to disable strict verification — the endpoint
# then only accepts explicit demo-mode deliveries (X-PAYSCAPE-DEMO: 1 when
# DEMO_MODE=true) and records signature_verified=false.
RAZORPAY_WEBHOOK_SECRET=